# ==============================================================================
# BOT TELEGRAM ORCHESTRATOR - BIẾN MÔI TRƯỜNG
# ==============================================================================
# SAO CHÉP file này thành .env và điền giá trị thực tế
# KHÔNG commit file .env lên Git repository

# --- Token của Bot Telegram (lấy từ @BotFather) ---
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here

# --- Link trang WebApp (Mini App) - PHẢI là HTTPS ---
WEB_APP_URL=https://zachxaviors.github.io/telegram-fakegttt/

# --- URL FastAPI Backend (bot gọi sang backend để OCR + Inpaint) ---
BACKEND_API_URL=http://localhost:8000

# --- Cổng kết nối OpenAI-Compatible API (CKEY) cho Vision ---
CKEY_BASE_URL=https://api.xah.io/v1
CKEY_API_KEY=sk-8b4485df1fe685277152255a923fc0a37a59d3f4e5054d2dcf921510eebe9b61

# --- Cổng kết nối OpenAI API cho Image Editing (GPT Image 2) ---
OPENAI_API_KEY=sk-8b4485df1fe685277152255a923fc0a37a59d3f4e5054d2dcf921510eebe9b61
OPENAI_EDIT_URL=https://api.xah.io/v1/images/edits
OPENAI_IMAGE_MODEL=phatchau036/gpt-image-2

# --- Tên model Vision (Qwen2.5-VL hoặc mimo-v2.5) ---
CKEY_VISION_MODEL=qwen2.5-vl-72b-instruct

# --- ID Telegram của admin (phân tách bằng dấu phẩy nếu nhiều người) ---
AUTHORIZED_KEY_ADMIN_IDS=8329365661

# --- Số ngày hiệu lực mặc định cho Key ---
KEY_VALID_DAYS=30

# --- Cấu hình GitHub (để đồng bộ keys.json) ---
GITHUB_TOKEN=your_github_personal_access_token_here
GITHUB_REPO_OWNER=zachxaviors
GITHUB_REPO_NAME=telegram-fakegttt
GITHUB_REPO_BRANCH=main
GITHUB_KEYS_FILE_PATH=keys.json
